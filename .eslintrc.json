{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["@typescript-eslint", "react", "react-hooks"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:react/recommended",
    "plugin:react-hooks/recommended"
  ],
  "settings": {
    "react": {
      "version": "detect"
    }
  },
  "rules": {
    // ─── TypeScript ───────────────────────────────────────────────────
    // any 타입 사용 시 경고 (완전 금지 대신 warn — FX props 확장성 고려)
    "@typescript-eslint/no-explicit-any": "warn",
    // interface 우선 (type alias 대신). Gemini와 스타일 충돌 방지 핵심 규칙.
    "@typescript-eslint/consistent-type-definitions": ["error", "interface"],
    // 사용하지 않는 변수 금지. _ 접두어 예외 허용 (의도적 무시 표시용)
    "@typescript-eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    // null 단언(!) 과용 경고 — optional chaining(?.) 권장
    "@typescript-eslint/no-non-null-assertion": "warn",

    // ─── React ───────────────────────────────────────────────────────
    // React 18 — JSX transform 불필요하나 프로젝트 전체가 명시적 import 유지
    // "off"로 두되 기존 import는 유지 (Gemini가 빠뜨려도 에러 없음)
    "react/react-in-jsx-scope": "off",
    // TypeScript가 prop 타입을 보장하므로 propTypes 불필요
    "react/prop-types": "off",
    // 익명 컴포넌트 패턴 금지 해제 (React.FC 패턴 자체가 이름을 보장)
    "react/display-name": "off",
    // Hook 의존성 배열 누락 방지 — Remotion의 useCurrentFrame 등
    "react-hooks/exhaustive-deps": "warn",

    // ─── 내보내기 규칙: Named export만 허용 ───────────────────────────
    // Gemini가 "export default"를 생성했을 때 즉시 감지하기 위한 규칙
    "no-restricted-syntax": [
      "error",
      {
        "selector": "ExportDefaultDeclaration",
        "message": "Default export 금지. Named export를 사용하세요 (예: export const MyFX: React.FC<Props> = ...)"
      }
    ],

    // ─── 코드 품질 ────────────────────────────────────────────────────
    // var 금지: const / let만 허용
    "no-var": "error",
    // 재할당 없으면 const 강제
    "prefer-const": "error",
    // == 대신 === 강제 (null 체크 예외 없음)
    "eqeqeq": ["error", "always"],
    // console.log 잔존 경고 (FX 디버깅 후 제거 유도)
    "no-console": "warn"
  },

  "ignorePatterns": ["node_modules/", "out/", "dist/", "*.min.js"]
}
