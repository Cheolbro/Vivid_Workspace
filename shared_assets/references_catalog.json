{
  "$schema_version": "2.0.0",
  "last_updated": "2026-04-30",
  "description": "v4.5 references catalog. 4 categories (characters / props / static_assets / auto_generated_assets). Node 4 performs 5-tier search; Node 7 loads file_path into LoadImage; Node 9.5 auto-archives generate_asset:true outputs into auto_generated_assets.",
  "references_root": "assets/references/",
  "static_assets_root": "assets/static/",
  "auto_generated_root": "assets/static/auto_generated/",
  "global_style_anchor": {
    "version": "1.0.0",
    "anchor_text": "informative webtoon style, noir economic illustration, bold clean vector lines",
    "updated_at": "2026-04-30",
    "_comment": "Suffix-injected into Node 4 description_render output (code-enforced). Operator updates every ~6 months and bumps version. Mismatched style_anchor_version items are demoted (not auto-excluded) in Node 4 search ranking."
  },
  "lookup_rules": {
    "id_format": {
      "character": "char_<character_key>_<angle>",
      "prop": "prop_<prop_key>",
      "static": "static_<key>",
      "auto_generated": "auto_<sha1_12char>"
    },
    "character_angle_keys": ["front", "side", "back"],
    "missing_id_behavior": "If Node 4 emits ref_image_id == 'none' (new/extra character or prop), Node 7 must Bypass FaceID/IP-Adapter and switch to pure text-to-image mode.",
    "search_priority_5_tier": [
      "1. characters (match_score >= 0.7, FaceID enforced)",
      "2. static_assets (exact ID match, no embedding search)",
      "3. auto_generated_assets (cosine >= 0.85 via hnswlib)",
      "4. props (match_score >= 0.7, img2img)",
      "5. generate_asset:true (new ComfyUI call, archived by Node 9.5)"
    ]
  },
