# gemini CLI용 ignore — .gitignore의 미디어 바이너리 제외를 이미지만 해제
# 대용량 바이너리는 여전히 제외
*.mp4
*.mp3
*.wav
*.webm

# ── npm 의존성 (수백 MB) ──────────────────────────
**/node_modules/

# ── Remotion 렌더 출력물 ─────────────────────────
**/out/
**/renders/

# ── Python 캐시 ──────────────────────────────────
**/__pycache__/
**/*.pyc
**/*.pyo

# ── 문서/아카이브 ────────────────────────────────
**/*.pdf
**/*.zip

# ── Vrew 프로젝트 파일 (ZIP 아카이브) ────────────
**/*.vrew

# ── 자막 파일 ────────────────────────────────────
**/*.srt

# ── 렌더 캐시 (자동 생성) ────────────────────────
**/render_cache.json

# ── 로그 ─────────────────────────────────────────
**/*.log

# 이미지는 멀티모달 분석용으로 허용
!*.jpeg
!*.jpg
!*.png
!*.webp
