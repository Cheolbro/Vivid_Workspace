# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# .claudeignore  —  Vivid_Workspace
# 토큰 절약을 위해 Claude가 읽지 않아도 되는 파일/폴더
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── npm 의존성 (수백 MB) ──────────────────────────
**/node_modules/

# ── Remotion 렌더 출력물 ─────────────────────────
**/out/
**/renders/

# ── Python 캐시 ──────────────────────────────────
**/__pycache__/
**/*.pyc
**/*.pyo

# ── 바이너리 미디어 파일 ──────────────────────────
**/*.mp4
**/*.webm
**/*.mp3
**/*.wav

# ── 이미지 파일 ──────────────────────────────────
**/*.jpeg
**/*.jpg
**/*.png
**/*.gif
**/*.webp

# ── 문서/아카이브 ────────────────────────────────
**/*.pdf
**/*.zip

# ── Vrew 프로젝트 파일 (ZIP 아카이브) ────────────
**/*.vrew

# ── 자막 파일 ────────────────────────────────────
**/*.srt

# ── 렌더 캐시 (자동 생성) ────────────────────────
**/render_cache.json

# ── 로그 ─────────────────────────────────────────
**/*.log
