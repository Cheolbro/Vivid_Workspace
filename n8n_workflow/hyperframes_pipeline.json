{
  "name": "VIVID v5.0 — Master Pipeline",
  "nodes": [
    {
      "id": "trigger-webhook",
      "name": "Webhook — Pipeline Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 400],
      "parameters": {
        "httpMethod": "POST",
        "path": "vivid-pipeline",
        "responseMode": "lastNode",
        "options": {}
      },
      "webhookId": "vivid-pipeline"
    },
    {
      "id": "node-01-load",
      "name": "Load Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 400],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// 과제 26: node1_load_files.js 내용을 여기에 붙여넣기.\n// 코드 본체는 n8n_workflow/nodes/node1_load_files.js에서 관리.\n// Node 1 + Node 1.1 + Node 1.2 통합 (대본 청킹 → 범퍼 분기 → FFmpeg 오디오 분할).\n// 출력: 챕터별 n8n 아이템 배열 (type: INTRO|BUMPER_TRIGGER|CHAPTER).\nthrow new Error('[Master] node1_load_files.js 코드를 이 Code Node에 붙여넣으세요.');"
      }
    },
    {
      "id": "node-01-filter-bumper",
      "name": "IF — Bumper Filter",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 400],
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.type }}",
              "operation": "equals",
              "value2": "BUMPER_TRIGGER"
            }
          ]
        }
      }
    },
    {
      "id": "node-01-bumper-passthrough",
      "name": "Bumper — Concat Entry",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3,
      "position": [920, 260],
      "parameters": {
        "mode": "manual",
        "duplicateItem": false,
        "assignments": {
          "assignments": [
            { "name": "concat_type", "value": "bumper", "type": "string" },
            { "name": "concat_path", "value": "={{ $json.bumper_path }}", "type": "string" },
            { "name": "chapter_id", "value": "={{ $json.chapter_id }}", "type": "string" },
            { "name": "chapter_index", "value": "={{ $json.chapter_index }}", "type": "number" }
          ]
        }
      }
    },
    {
      "id": "node-dispatch-chapter",
      "name": "Execute Sub-workflow (Chapter)",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [920, 540],
      "parameters": {
        "workflowId": "={{ $env.VIVID_CHAPTER_SUBWORKFLOW_ID }}",
        "options": {}
      },
      "_comment": "챕터별 Sub-workflow 비동기 디스패치. 환경변수 VIVID_CHAPTER_SUBWORKFLOW_ID에 pipeline_chapter 워크플로우 ID 설정 필요."
    },
    {
      "id": "node-aggregate",
      "name": "Aggregate — All Chapters",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1200, 400],
      "parameters": {
        "mode": "append"
      },
      "_comment": "Bumper passthrough + 모든 챕터 Sub-workflow 결과를 합침. chapter_index 기준 정렬 후 Node 12로."
    },
    {
      "id": "node-sort-chapters",
      "name": "Sort by Chapter Index",
      "type": "n8n-nodes-base.sort",
      "typeVersion": 1,
      "position": [1440, 400],
      "parameters": {
        "sortFieldsUi": {
          "sortField": [
            {
              "fieldName": "chapter_index",
              "order": "ascending"
            }
          ]
        }
      }
    },
    {
      "id": "node-12-merge",
      "name": "Node 12 — Final Merge",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1680, 400],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// 과제 기구현: n8n_workflow/nodes/node12_final_merge.js 내용 붙여넣기.\n// FFmpeg concat + 인코딩 지문 분산 (CRF 19-21, GOP 90-150, h264_qsv).\n// 입력: 정렬된 챕터/범퍼 아이템. concat_type='bumper'→bumper.mp4, 'chapter'→render/chapter_NN.mp4.\nthrow new Error('[Master] node12_final_merge.js 코드를 이 Code Node에 붙여넣으세요.');"
      }
    },
    {
      "id": "node-13-vrew",
      "name": "Node 13 — Vrew Builder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1920, 400],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// 과제 기구현: n8n_workflow/nodes/node13_vrew_builder.js 내용 붙여넣기.\n// 원본 .vrew에 비디오 트랙 주입 → 최종_hf_vN.vrew 패키징.\n// EF-8: 반드시 모든 챕터 완료 후 1회만 호출.\nthrow new Error('[Master] node13_vrew_builder.js 코드를 이 Code Node에 붙여넣으세요.');"
      }
    },
    {
      "id": "node-error-telegram",
      "name": "Error — Telegram Alert",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [1920, 640],
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "🚨 VIVID Pipeline 실패\n\n{{ $json.error_message || '알 수 없는 오류' }}\n\n챕터: {{ $json.chapter_id || 'N/A' }}\n시간: {{ $now.toISO() }}",
        "additionalFields": {}
      }
    }
  ],
  "connections": {
    "Webhook — Pipeline Trigger": {
      "main": [[{ "node": "Load Files", "type": "main", "index": 0 }]]
    },
    "Load Files": {
      "main": [[{ "node": "IF — Bumper Filter", "type": "main", "index": 0 }]]
    },
    "IF — Bumper Filter": {
      "main": [
        [{ "node": "Bumper — Concat Entry", "type": "main", "index": 0 }],
        [{ "node": "Execute Sub-workflow (Chapter)", "type": "main", "index": 0 }]
      ]
    },
    "Bumper — Concat Entry": {
      "main": [[{ "node": "Aggregate — All Chapters", "type": "main", "index": 0 }]]
    },
    "Execute Sub-workflow (Chapter)": {
      "main": [[{ "node": "Aggregate — All Chapters", "type": "main", "index": 1 }]]
    },
    "Aggregate — All Chapters": {
      "main": [[{ "node": "Sort by Chapter Index", "type": "main", "index": 0 }]]
    },
    "Sort by Chapter Index": {
      "main": [[{ "node": "Node 12 — Final Merge", "type": "main", "index": 0 }]]
    },
    "Node 12 — Final Merge": {
      "main": [[{ "node": "Node 13 — Vrew Builder", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": null,
  "pinData": {},
  "id": "vivid-master-pipeline-v45",
  "meta": {
    "instanceId": "vivid-studio-local",
    "templateCredsSetupCompleted": true
  },
  "tags": [{ "name": "vivid" }, { "name": "v4.5" }, { "name": "master" }],
  "_vivid_meta": {
    "version": "5.0.0",
    "description": "Master Pipeline — Node 1/1.1/1.2 입구 → IF(Bumper) 분기 → 챕터별 Sub-workflow 비동기 디스패치 → Aggregate → Node 12 Merge → Node 13 Vrew. GPU/CPU 이종 파이프라이닝은 Sub-workflow 디스패치 타이밍으로 구현.",
    "env_requirements": {
      "NODE_FUNCTION_ALLOW_BUILTIN": "*",
      "NODE_FUNCTION_ALLOW_EXTERNAL": "adm-zip",
      "VIVID_CHAPTER_SUBWORKFLOW_ID": "pipeline_chapter 워크플로우 ID",
      "TELEGRAM_CHAT_ID": "에러 알림 수신 Telegram 채팅 ID",
      "PEXELS_API_KEY": "Pexels API 키 (V5.0 b_roll_video 비디오 검색용)",
      "PIXABAY_API_KEY": "Pixabay API 키 (V5.0 real_photo 이미지 검색용)"
    },
    "node_code_files": {
      "Load Files": "n8n_workflow/nodes/node1_load_files.js",
      "Node 12 — Final Merge": "n8n_workflow/nodes/node12_final_merge.js",
      "Node 13 — Vrew Builder": "n8n_workflow/nodes/node13_vrew_builder.js"
    }
  }
}
