{
  "_meta": {
    "title": "7A_character — text2img + FaceID + IP-Adapter + LoRA + LayerDiffusion/BRIA RMBG (투명 PNG)",
    "version": "4.5.0",
    "description": "캐릭터 전용 ComfyUI 워크플로우. Node 7 JS가 {{PLACEHOLDER}} 값을 동적 덮어쓰기.",
    "modes": {
      "auto": "Q5_K_M + IP-Adapter 0.65, ControlNet 비활성",
      "controlled": "Q4_K_M 다운그레이드 + ControlNet OpenPose + IP-Adapter 0.35"
    }
  },
  "1": {
    "class_type": "UnetLoaderGGUF",
    "inputs": {
      "unet_name": "{{MODEL_GGUF}}"
    },
    "_inject": {
      "auto": "flux1-schnell-Q5_K_M.gguf",
      "controlled": "flux1-schnell-Q4_K_M.gguf"
    }
  },
  "1c": {
    "class_type": "DualCLIPLoaderGGUF",
    "inputs": {
      "clip_name1": "t5xxl_fp8.gguf",
      "clip_name2": "clip_l.safetensors",
      "type": "flux"
    }
  },
  "1v": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{POSITIVE_PROMPT}}",
      "clip": ["1c", 0]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "watermark, text, signature, low quality, blurry, deformed, extra limbs, bad anatomy",
      "clip": ["1c", 0]
    }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{REF_IMAGE_PATH}}"
    },
    "_comment": "FaceID/IP-Adapter 레퍼런스 이미지 (선택된 character variant)"
  },
  "11": {
    "class_type": "IPAdapterFaceID",
    "inputs": {
      "model": ["1", 0],
      "ipadapter": "ip-adapter-faceid-portrait_sd15.bin",
      "image": ["10", 0],
      "weight": 0.85
    },
    "_comment": "FaceID 가중치 0.85 고정"
  },
  "12": {
    "class_type": "IPAdapterAdvanced",
    "inputs": {
      "model": ["11", 0],
      "ipadapter": "ip-adapter_sd15.safetensors",
      "image": ["10", 0],
      "weight": "{{IP_ADAPTER_WEIGHT}}"
    },
    "_inject": {
      "auto": 0.65,
      "controlled": 0.35
    }
  },
  "13": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["12", 0],
      "clip": ["1c", 0],
      "lora_name": "{{LORA_NAME}}",
      "strength_model": "{{LORA_STRENGTH}}",
      "strength_clip": "{{LORA_STRENGTH}}"
    },
    "_inject_defaults": {
      "lora_name": "noir_webtoon_style.safetensors",
      "strength": [0.6, 0.85]
    }
  },
  "20": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{POSE_PNG_PATH}}"
    },
    "_comment": "ControlNet OpenPose 뼈대 PNG — controlled 모드에서만 활성",
    "_controlled_only": true
  },
  "21": {
    "class_type": "ControlNetLoader",
    "inputs": {
      "control_net_name": "control_v11p_sd15_openpose.pth"
    },
    "_controlled_only": true
  },
  "22": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["2", 0],
      "negative": ["3", 0],
      "control_net": ["21", 0],
      "image": ["20", 0],
      "strength": 0.7,
      "start_percent": 0.0,
      "end_percent": 1.0
    },
    "_controlled_only": true,
    "_comment": "controlled 모드: positive/negative 출력이 KSampler로 흐름. auto 모드에서는 노드 20~22 전체 bypass."
  },
  "30": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["13", 0],
      "positive": "{{POSITIVE_OUT}}",
      "negative": "{{NEGATIVE_OUT}}",
      "latent_image": ["4", 0],
      "seed": "{{SEED}}",
      "steps": "{{SAMPLING_STEPS}}",
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    },
    "_inject": {
      "auto": {
        "positive": ["2", 0],
        "negative": ["3", 0],
        "steps": 3
      },
      "controlled": {
        "positive": ["22", 0],
        "negative": ["22", 1],
        "steps": 4
      }
    }
  },
  "31": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["30", 0],
      "vae": ["1v", 0]
    }
  },
  "40": {
    "class_type": "LayeredDiffusionDecode",
    "inputs": {
      "image": ["31", 0],
      "samples": ["30", 0]
    },
    "_comment": "투명 PNG 알파 분리. BRIA RMBG 대체 가능."
  },
  "50": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["40", 0],
      "filename_prefix": "{{OUTPUT_PREFIX}}"
    }
  },
  "99": {
    "class_type": "HttpRequest",
    "inputs": {
      "url": "{{N8N_RESUME_WEBHOOK}}",
      "method": "POST",
      "body": {
        "resumeKey": "{{PROMPT_ID}}",
        "file_path": "{{OUTPUT_FILE_PATH}}",
        "asset_type": "character",
        "status": "complete"
      }
    },
    "_comment": "n8n 웹훅 콜백 — resumeKey로 Node 8 세션 복구"
  }
}
