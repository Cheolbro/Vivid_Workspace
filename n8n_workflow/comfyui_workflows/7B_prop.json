{
  "_meta": {
    "title": "7B_prop — img2img(denoise 0.5) + 투명 PNG",
    "version": "4.5.0",
    "description": "소품 전용 ComfyUI 워크플로우. ref_image_id:'none'이면 text2img 폴백 + IP-Adapter unload. Node 7 JS가 {{PLACEHOLDER}} 값을 동적 덮어쓰기.",
    "modes": {
      "with_ref": "img2img denoise 0.5 + IP-Adapter 0.65 (실루엣 일관성)",
      "none_ref": "text2img 폴백 + IP-Adapter weight=0 모델 unload (0.5GB VRAM 회수)"
    }
  },
  "1": {
    "class_type": "UnetLoaderGGUF",
    "inputs": {
      "unet_name": "flux1-schnell-Q5_K_M.gguf"
    }
  },
  "1c": {
    "class_type": "DualCLIPLoaderGGUF",
    "inputs": {
      "clip_name1": "t5xxl_fp8.gguf",
      "clip_name2": "clip_l.safetensors",
      "type": "flux"
    }
  },
  "1v": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{POSITIVE_PROMPT}}",
      "clip": ["1c", 0]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "watermark, text, signature, low quality, blurry, deformed, extra limbs, bad anatomy",
      "clip": ["1c", 0]
    }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1024,
      "height": 1024,
      "batch_size": 1
    },
    "_comment": "ref_image_id='none' text2img 폴백 시 사용. with_ref 모드에서는 10e VAEEncode 출력으로 대체됨."
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{{REF_IMAGE_PATH}}"
    },
    "_comment": "소품 레퍼런스 이미지 — with_ref 모드에서만 활성",
    "_with_ref_only": true
  },
  "10e": {
    "class_type": "VAEEncode",
    "inputs": {
      "pixels": ["10", 0],
      "vae": ["1v", 0]
    },
    "_comment": "img2img: 레퍼런스 이미지를 latent로 인코딩",
    "_with_ref_only": true
  },
  "12": {
    "class_type": "IPAdapterAdvanced",
    "inputs": {
      "model": ["1", 0],
      "ipadapter": "ip-adapter_sd15.safetensors",
      "image": ["10", 0],
      "weight": "{{IP_ADAPTER_WEIGHT}}"
    },
    "_inject": {
      "with_ref": 0.65,
      "none_ref": 0.0
    },
    "_comment": "none_ref: weight=0 + 모델 자체 unload 시 이 노드를 bypass 처리",
    "_with_ref_only": true
  },
  "13": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": "{{MODEL_INPUT}}",
      "clip": ["1c", 0],
      "lora_name": "{{LORA_NAME}}",
      "strength_model": "{{LORA_STRENGTH}}",
      "strength_clip": "{{LORA_STRENGTH}}"
    },
    "_inject": {
      "with_ref": {
        "model_input": ["12", 0]
      },
      "none_ref": {
        "model_input": ["1", 0]
      }
    },
    "_inject_defaults": {
      "lora_name": "noir_webtoon_style.safetensors",
      "strength": [0.6, 0.85]
    }
  },
  "30": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["13", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": "{{LATENT_INPUT}}",
      "seed": "{{SEED}}",
      "steps": 3,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": "{{DENOISE_STRENGTH}}"
    },
    "_inject": {
      "with_ref": {
        "latent_image": ["10e", 0],
        "denoise": 0.5
      },
      "none_ref": {
        "latent_image": ["4", 0],
        "denoise": 1.0
      }
    }
  },
  "31": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["30", 0],
      "vae": ["1v", 0]
    }
  },
  "40": {
    "class_type": "LayeredDiffusionDecode",
    "inputs": {
      "image": ["31", 0],
      "samples": ["30", 0]
    },
    "_comment": "투명 PNG 알파 분리"
  },
  "50": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["40", 0],
      "filename_prefix": "{{OUTPUT_PREFIX}}"
    }
  },
  "99": {
    "class_type": "HttpRequest",
    "inputs": {
      "url": "{{N8N_RESUME_WEBHOOK}}",
      "method": "POST",
      "body": {
        "resumeKey": "{{PROMPT_ID}}",
        "file_path": "{{OUTPUT_FILE_PATH}}",
        "asset_type": "prop",
        "status": "complete"
      }
    },
    "_comment": "n8n 웹훅 콜백 — resumeKey로 Node 8 세션 복구"
  }
}
