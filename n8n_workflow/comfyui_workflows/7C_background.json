{
  "_meta": {
    "title": "7C_background — 순수 FLUX text2img, 1920x1088, 불투명",
    "version": "4.5.0",
    "description": "배경 전용 ComfyUI 워크플로우. IP-Adapter/FaceID 완전 제거. 16:9 비율 + No Alpha. Node 7 JS가 {{PLACEHOLDER}} 값을 동적 덮어쓰기."
  },
  "1": {
    "class_type": "UnetLoaderGGUF",
    "inputs": {
      "unet_name": "flux1-schnell-Q5_K_M.gguf"
    }
  },
  "1c": {
    "class_type": "DualCLIPLoaderGGUF",
    "inputs": {
      "clip_name1": "t5xxl_fp8.gguf",
      "clip_name2": "clip_l.safetensors",
      "type": "flux"
    }
  },
  "1v": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "ae.safetensors"
    }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{POSITIVE_PROMPT}}",
      "clip": ["1c", 0]
    }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "watermark, text, signature, low quality, blurry, deformed",
      "clip": ["1c", 0]
    }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1920,
      "height": 1088,
      "batch_size": 1
    },
    "_comment": "16:9 비율 (1920x1088 — 64 정렬). FLUX 권장 멀티플."
  },
  "13": {
    "class_type": "LoraLoader",
    "inputs": {
      "model": ["1", 0],
      "clip": ["1c", 0],
      "lora_name": "{{LORA_NAME}}",
      "strength_model": "{{LORA_STRENGTH}}",
      "strength_clip": "{{LORA_STRENGTH}}"
    },
    "_inject_defaults": {
      "lora_name": "noir_webtoon_style.safetensors",
      "strength": [0.6, 0.85]
    }
  },
  "30": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["13", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["4", 0],
      "seed": "{{SEED}}",
      "steps": 3,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "31": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["30", 0],
      "vae": ["1v", 0]
    }
  },
  "50": {
    "class_type": "SaveImage",
    "inputs": {
      "images": ["31", 0],
      "filename_prefix": "{{OUTPUT_PREFIX}}"
    },
    "_comment": "배경은 Alpha 없음 — VAEDecode 결과를 바로 저장 (LayerDiffusion 미사용)"
  },
  "99": {
    "class_type": "HttpRequest",
    "inputs": {
      "url": "{{N8N_RESUME_WEBHOOK}}",
      "method": "POST",
      "body": {
        "resumeKey": "{{PROMPT_ID}}",
        "file_path": "{{OUTPUT_FILE_PATH}}",
        "asset_type": "background",
        "status": "complete"
      }
    },
    "_comment": "n8n 웹훅 콜백 — resumeKey로 Node 8 세션 복구"
  }
}
